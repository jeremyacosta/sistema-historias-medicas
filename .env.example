# ============================================================
#  .env.example — Plantilla de Variables de Entorno
#  INSTRUCCIONES: Copia este archivo a ".env" en tu máquina
#  y rellena con TUS credenciales locales. NUNCA subas .env
# ============================================================

# ── Base de Datos (PostgreSQL Local) ─────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hospital_baquero
DB_USER=tu_usuario_postgres
DB_PASSWORD=tu_contraseña_postgres

# URL completa (generada automáticamente por el backend)
# DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME

# ── Backend FastAPI ──────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development          # development | production
APP_DEBUG=true

# ── Seguridad JWT ────────────────────────────────────────────
# Genera tu propia clave: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_SECRETA_DE_64_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480     # 8 horas de sesión clínica

# ── Frontend React (Vite) ────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME="Sistema de Historias Médicas - Baquero González"
