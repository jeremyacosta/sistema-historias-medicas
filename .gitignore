# ============================================================
#  .gitignore — Sistema Interoperable Hospital Baquero González
#  Regla de Oro: NUNCA subas credenciales ni entornos locales.
# ============================================================

# ── Entorno Python (Backend) ─────────────────────────────────
venv/
.venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.mypy_cache/
.pytest_cache/

# ── Variables de entorno (CRÍTICO: nunca subir) ──────────────
.env
*.env
!.env.example

# ── Node.js / React (Frontend) ───────────────────────────────
node_modules/
dist/
.next/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Sistema Operativo ────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Archivos temporales de Word/Office ───────────────────────
~$*.docx
~$*.doc
~$*.xlsx
~WRL*.tmp

# ── IDEs / Editores ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Archivos de base de datos locales ────────────────────────
*.sqlite
*.db
*.sqlite3

# ── Pytest / Coverage ────────────────────────────────────────
.coverage
htmlcov/
